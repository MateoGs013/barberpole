# BarberPole — Variables de Entorno del Frontend
# En desarrollo local con proxy de Vite hacia el backend local, dejar VITE_API_URL vacío.
# En producción (ej: Vercel/Netlify), configurar con la URL pública de la API:
# VITE_API_URL=https://api.tudominio.com/api
VITE_API_URL=

# ID de cliente Google OAuth 2.0 (Google Cloud Console > Credentials > OAuth 2.0 Client IDs)
# VITE_GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=
