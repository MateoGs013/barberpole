# BarberPole - Variables de Entorno del Backend
PORT=4000
MONGODB_URI=mongodb://localhost:27017/peluqueria
JWT_SECRET=tu_secreto_jwt_seguro_y_largo_para_produccion
JWT_EXPIRES_IN=7d
# Nivel de log de pino: fatal|error|warn|info|debug|trace|silent
LOG_LEVEL=info
FRONTEND_URL=http://localhost:5173,http://localhost:3000

# Emails con privilegios de Superadmin al iniciar sesión con Google o correo local (separados por coma)
SUPERADMIN_EMAILS=superadmin@tudominio.com,mateo@midominio.com

# Credenciales para inicialización de Superadmin y Admin (npm run seed)
INITIAL_SUPERADMIN_EMAIL=superadmin@tudominio.com
INITIAL_SUPERADMIN_PASSWORD=ContraseñaSuperadminSegura123!
INITIAL_ADMIN_EMAIL=admin@tudominio.com
INITIAL_ADMIN_PASSWORD=ContraseñaAdminSegura123!

# Google OAuth 2.0 / Google Calendar.
# GOOGLE_CLIENT_ID es OBLIGATORIO en producción: se usa para validar la audiencia (aud)
# del ID token al iniciar sesión con Google. Debe coincidir con el VITE_GOOGLE_CLIENT_ID
# del frontend. Admite varios client_id separados por coma (web + móvil).
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_client_secret_de_google
# URI de redirección registrada en Google Cloud Console para el callback de Calendar
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:4000/api/empleados/google-calendar/callback
